<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/widget_bg" android:padding="8dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
        <LinearLayout android:id="@+id/act_lucky" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp"
            android:background="@drawable/widget_tile" android:orientation="vertical" android:gravity="center" android:padding="6dp">
            <ImageView android:id="@+id/act_lucky_icon" android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/ic_w_dice" android:contentDescription="@null" />
            <TextView android:id="@+id/act_lucky_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="#FFFFFFFF" android:textSize="11.5sp" android:singleLine="true" android:ellipsize="end" android:text="Feeling lucky" />
        </LinearLayout>
        <LinearLayout android:id="@+id/act_sleep" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp"
            android:background="@drawable/widget_tile" android:orientation="vertical" android:gravity="center" android:padding="6dp">
            <ImageView android:id="@+id/act_sleep_icon" android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/ic_w_moon" android:contentDescription="@null" />
            <TextView android:id="@+id/act_sleep_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="#FFFFFFFF" android:textSize="11.5sp" android:singleLine="true" android:ellipsize="end" android:text="Sleep 30 min" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
        <LinearLayout android:id="@+id/act_pauseall" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp"
            android:background="@drawable/widget_tile" android:orientation="vertical" android:gravity="center" android:padding="6dp">
            <ImageView android:id="@+id/act_pauseall_icon" android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/ic_w_pause_all" android:contentDescription="@null" />
            <TextView android:id="@+id/act_pauseall_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="#FFFFFFFF" android:textSize="11.5sp" android:singleLine="true" android:ellipsize="end" android:text="Pause others" />
        </LinearLayout>
        <LinearLayout android:id="@+id/act_switch" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp"
            android:background="@drawable/widget_tile" android:orientation="vertical" android:gravity="center" android:padding="6dp">
            <ImageView android:id="@+id/act_switch_icon" android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/ic_w_phone" android:contentDescription="@null" />
            <TextView android:id="@+id/act_switch_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="#FFFFFFFF" android:textSize="11.5sp" android:singleLine="true" android:ellipsize="end" android:text="Play on phone" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
