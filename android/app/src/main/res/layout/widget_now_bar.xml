<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_bg">
    <ImageView android:id="@+id/bg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:contentDescription="@null" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="10dp" android:paddingEnd="8dp">
        <ImageView android:id="@+id/cover" android:layout_width="48dp" android:layout_height="48dp" android:scaleType="fitXY" android:src="@drawable/ic_w_music" android:contentDescription="Cover" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
            <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFFFF" android:textSize="15sp" android:textStyle="bold" android:singleLine="true" android:ellipsize="end" android:text="Nothing playing" />
            <TextView android:id="@+id/artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#DDFFFFFF" android:textSize="12.5sp" android:singleLine="true" android:ellipsize="end" />
        </LinearLayout>
        <ImageView android:id="@+id/prev" android:layout_width="40dp" android:layout_height="40dp" android:padding="8dp"
                android:src="@drawable/ic_w_prev" android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="Previous" />
        <FrameLayout android:id="@+id/play_box" android:layout_width="44dp" android:layout_height="44dp" android:layout_marginStart="4dp" android:layout_marginEnd="4dp">
                <ImageView android:id="@+id/play_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/widget_circle" android:contentDescription="@null" />
                <ImageView android:id="@+id/play" android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:src="@drawable/ic_w_play" android:contentDescription="Play or pause" />
            </FrameLayout>
        <ImageView android:id="@+id/next" android:layout_width="40dp" android:layout_height="40dp" android:padding="8dp"
                android:src="@drawable/ic_w_next" android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="Next" />
    </LinearLayout>
</FrameLayout>
