<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/widget_card" android:paddingStart="10dp" android:paddingEnd="8dp" android:paddingTop="8dp" android:paddingBottom="8dp">
    <ImageView android:id="@+id/cover" android:layout_width="52dp" android:layout_height="52dp" android:scaleType="fitXY" android:src="@drawable/ic_w_music" android:contentDescription="Cover" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><TextView android:id="@+id/title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="#FFF2F3F7" android:textSize="15sp" android:textStyle="bold" android:singleLine="true" android:ellipsize="end" android:text="Nothing playing" /></LinearLayout>
        <TextView android:id="@+id/artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFA9ACB6" android:textSize="12.5sp" android:singleLine="true" android:ellipsize="end" />
    </LinearLayout>
    <FrameLayout android:id="@+id/prev" android:layout_width="38dp" android:layout_height="38dp" android:layout_marginStart="6dp" android:layout_marginEnd="6dp">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/widget_circle_dark" android:contentDescription="@null" />
                <ImageView android:id="@+id/prev_icon" android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="center" android:src="@drawable/ic_w_prev" android:contentDescription="Previous" />
            </FrameLayout>
    <FrameLayout android:id="@+id/play_box" android:layout_width="46dp" android:layout_height="46dp" android:layout_marginStart="6dp" android:layout_marginEnd="6dp">
                <ImageView android:id="@+id/play_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/widget_circle" android:contentDescription="@null" />
                <ImageView android:id="@+id/play" android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:src="@drawable/ic_w_play" android:contentDescription="Play or pause" />
            </FrameLayout>
    <FrameLayout android:id="@+id/next" android:layout_width="38dp" android:layout_height="38dp" android:layout_marginStart="6dp" android:layout_marginEnd="6dp">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/widget_circle_dark" android:contentDescription="@null" />
                <ImageView android:id="@+id/next_icon" android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="center" android:src="@drawable/ic_w_next" android:contentDescription="Next" />
            </FrameLayout>
</LinearLayout>
