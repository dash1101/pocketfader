{
  "manifest_version": 3,
  "name": "YTM Starcast",
  "version": "2.3.1",
  "description": "Your YouTube Music companion: a remote for your phone, your music as your Discord status, and a better YouTube Music.",
  "key": "",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8777/*",
    "http://localhost:8777/*",
    "https://music.youtube.com/*"
  ],
  "action": {
    "default_title": "YTM Starcast",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://music.youtube.com/*"
      ],
      "js": [
        "ytm_main.js",
        "discord_ui.js",
        "stretch.js",
        "refine.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://music.youtube.com/*"
      ],
      "js": [
        "bridge_isolated.js"
      ],
      "world": "ISOLATED",
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "stretch.js"
      ],
      "matches": [
        "https://music.youtube.com/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle-discord": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "Show or stop showing your music on Discord"
    }
  }
}
