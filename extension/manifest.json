{
  "manifest_version": 3,
  "name": "YTM Starcast",
  "version": "2.0.0",
  "description": "Your YouTube Music companion: a remote for your phone, your music as your Discord status, and a better YouTube Music.",
  "host_permissions": [
    "http://127.0.0.1:8777/*",
    "http://localhost:8777/*",
    "https://music.youtube.com/*"
  ],
  "action": {
    "default_title": "YTM Starcast",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://music.youtube.com/*"
      ],
      "js": [
        "ytm_main.js",
        "refine.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://music.youtube.com/*"
      ],
      "js": [
        "bridge_isolated.js"
      ],
      "world": "ISOLATED",
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
