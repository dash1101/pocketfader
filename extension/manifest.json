{
  "manifest_version": 3,
  "name": "Pocketfader — YT Music Bridge",
  "version": "1.3.0",
  "description": "Lets the Pocketfader app control YouTube Music playing in this browser.",
  "host_permissions": [
    "http://127.0.0.1:8777/*",
    "http://localhost:8777/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://music.youtube.com/*"],
      "js": ["ytm_main.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": ["https://music.youtube.com/*"],
      "js": ["bridge_isolated.js"],
      "world": "ISOLATED",
      "run_at": "document_idle"
    }
  ]
}
