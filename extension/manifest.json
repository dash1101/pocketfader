{
  "manifest_version": 3,
  "name": "Pocketfader \u2014 YouTube Music bridge",
  "version": "1.15.0",
  "description": "Control YouTube Music in this browser from the Pocketfader app, and refine YouTube Music itself: look, speed, lyrics, playlists.",
  "host_permissions": [
    "http://127.0.0.1:8777/*",
    "http://localhost:8777/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://music.youtube.com/*"
      ],
      "js": [
        "ytm_main.js",
        "refine.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://music.youtube.com/*"
      ],
      "js": [
        "bridge_isolated.js"
      ],
      "world": "ISOLATED",
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}